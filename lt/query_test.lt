import Query from "./src/query.lt"
import Node from "./src/node.lt"
import Values from "./src/value.lt"
import ParseError from "./src/query.lt"

test class QueryTest {
  fn build() -> Query {
    Query.create()
      .select([Node.col("id"), Node.col("name")])
      .from_table(Node.table("users"))
      .where([Node.col("active").eq(Node.bool(true))])
      .order_by([Node.col("name").desc()])
      .limit(Node.int(10))
      .set_dialect("postgres")
  }

  test fn postgres_select() {
    let q = Query.create()
      .select([Node.col("id")])
      .from_table(Node.table("users"))
      .where([Node.col("active").eq(Node.bool(true))])
      .limit(Node.int(10))
      .set_dialect("postgres")
    match q.parse() {
      Ok(result) => {
        Expect.equal(result.sql, `SELECT "id" FROM "users" WHERE "active" = $1 LIMIT $2`)
        Expect.equal(result.sql_with_param, `SELECT "id" FROM "users" WHERE "active" = TRUE LIMIT 10`)
        Expect.equal(result.param.len(), 2)
      }
      Err(error) => Expect.equal("no error", "parse failed")
    }
  }

  test fn order_and_limit() {
    match Query.create()
      .select([Node.col("id"), Node.col("name")])
      .from_table(Node.table("users"))
      .where([Node.col("age").gte(Node.int(18))])
      .order_by([Node.col("name").desc()])
      .set_dialect("postgres")
      .parse() {
      Ok(result) => {
        Expect.equal(
          result.sql,
          `SELECT "id", "name" FROM "users" WHERE "age" >= $1 ORDER BY "name" DESC`,
        )
        Expect.equal(
          result.sql_with_param,
          `SELECT "id", "name" FROM "users" WHERE "age" >= 18 ORDER BY "name" DESC`,
        )
      }
      Err(error) => Expect.equal("no error", "parse failed")
    }
  }

  test fn qualified_identifier() {
    match Query.create()
      .select([Node.col("users.id")])
      .from_table(Node.table("public.users"))
      .set_dialect("postgres")
      .parse() {
      Ok(result) => Expect.equal(result.sql, `SELECT "users"."id" FROM "public"."users"`)
      Err(error) => Expect.equal("no error", "parse failed")
    }
  }

  test fn and_group_is_parenthesised() {
    match Query.create()
      .select([Node.col("id")])
      .where([Node.col("a").eq(Node.int(1)).and([Node.col("b").eq(Node.int(2))])])
      .set_dialect("postgres")
      .parse() {
      Ok(result) => Expect.equal(result.sql, `SELECT "id" WHERE ( "a" = $1 AND "b" = $2 )`)
      Err(error) => Expect.equal("no error", "parse failed")
    }
  }

  test fn missing_dialect() {
    match Query.create().select([Node.col("id")]).parse() {
      Ok(result) => Expect.equal("no error", "parse succeeded")
      Err(error) => match error {
        ParseError.NoDialect => Expect.equal("ok", "ok")
        _ => Expect.equal("NoDialect", "other error")
      }
    }
  }

  test fn unsupported_dialect() {
    match Query.create().select([Node.col("id")]).set_dialect("sqlite").parse() {
      Ok(result) => Expect.equal("no error", "parse succeeded")
      Err(error) => match error {
        ParseError.UnsupportedDialect(name) => Expect.equal(name, "sqlite")
        _ => Expect.equal("UnsupportedDialect", "other error")
      }
    }
  }

  test fn empty_query_is_rejected() {
    match Query.create().set_dialect("postgres").parse() {
      Ok(result) => Expect.equal("no error", "parse succeeded")
      Err(error) => match error {
        ParseError.EmptyQuery => Expect.equal("ok", "ok")
        _ => Expect.equal("EmptyQuery", "other error")
      }
    }
  }

  test fn string_literal_escapes_quote() {
    match Query.create()
      .select([Node.col("id")])
      .where([Node.col("name").eq(Node.str("o'brien"))])
      .set_dialect("postgres")
      .parse() {
      Ok(result) => Expect.equal(result.sql_with_param, `SELECT "id" WHERE "name" = 'o''brien'`)
      Err(error) => Expect.equal("no error", "parse failed")
    }
  }
}
