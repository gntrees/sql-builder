import Renderer from "./renderer.lt"
import Rendered from "./renderer.lt"
import Dialect from "./renderer.lt"
import Node from "./node.lt"
import Value from "./value.lt"
import Assignment from "./assignment.lt"

/// Satu klausa query, disimpan berurutan supaya `parse()` merender apa adanya.
pub enum Clause {
  Select(List<Node>)
  From(Node)
  Where(List<Node>)
  OrderBy(List<Node>)
  Limit(Node)
  Offset(Node)
  Raw(Str)
  Update(Node, List<Assignment>)
  Insert(Node, List<Assignment>)
  Delete(Node)
  Set(List<Assignment>)
  Values(List<List<Node>>)
  Returning(List<Node>)
  GroupBy(List<Node>)
  Having(List<Node>)
  Join(Str, Node, List<Node>)
  OnConflictDoNothing(Node)
  OnConflictDoUpdate(Node, List<Assignment>)
}

pub class ParseResult {
  sql: Str
  param: List<Value>
  sql_with_param: Str
}

pub enum ParseError {
  NoDialect
  UnsupportedDialect(Str)
  EmptyQuery
}

pub class Query {
  clauses: List<Clause>
  dialect: Option<Str>

  pub static fn create() -> Query {
    Query(clauses: [], dialect: None)
  }

  pub fn set_dialect(self, db: Str) -> Query {
    Query(clauses: self.clauses, dialect: Some(db))
  }

  pub fn select(self, columns: List<Node>) -> Query {
    self.add(Clause.Select(columns))
  }

  pub fn from_table(self, table: Node) -> Query {
    self.add(Clause.From(table))
  }

  pub fn where(self, conditions: List<Node>) -> Query {
    self.add(Clause.Where(conditions))
  }

  pub fn order_by(self, columns: List<Node>) -> Query {
    self.add(Clause.OrderBy(columns))
  }

  pub fn limit(self, count: Node) -> Query {
    self.add(Clause.Limit(count))
  }

  pub fn offset(self, count: Node) -> Query {
    self.add(Clause.Offset(count))
  }

  pub fn raw(self, text: Str) -> Query {
    self.add(Clause.Raw(text))
  }

  pub fn update(self, table: Node, assignments: List<Assignment>) -> Query {
    self.add(Clause.Update(table, assignments))
  }

  pub fn insert(self, table: Node, assignments: List<Assignment>) -> Query {
    self.add(Clause.Insert(table, assignments))
  }

  pub fn delete_from(self, table: Node) -> Query {
    self.add(Clause.Delete(table))
  }

  pub fn set(self, assignments: List<Assignment>) -> Query {
    self.add(Clause.Set(assignments))
  }

  pub fn values(self, rows: List<List<Node>>) -> Query {
    self.add(Clause.Values(rows))
  }

  pub fn returning(self, columns: List<Node>) -> Query {
    self.add(Clause.Returning(columns))
  }

  pub fn group_by(self, columns: List<Node>) -> Query {
    self.add(Clause.GroupBy(columns))
  }

  pub fn having(self, conditions: List<Node>) -> Query {
    self.add(Clause.Having(conditions))
  }

  pub fn join(self, table: Node, on: List<Node>) -> Query {
    self.add(Clause.Join("JOIN", table, on))
  }

  pub fn left_join(self, table: Node, on: List<Node>) -> Query {
    self.add(Clause.Join("LEFT JOIN", table, on))
  }

  pub fn right_join(self, table: Node, on: List<Node>) -> Query {
    self.add(Clause.Join("RIGHT JOIN", table, on))
  }

  pub fn inner_join(self, table: Node, on: List<Node>) -> Query {
    self.add(Clause.Join("INNER JOIN", table, on))
  }

  pub fn cross_join(self, table: Node, on: List<Node>) -> Query {
    self.add(Clause.Join("CROSS JOIN", table, on))
  }

  pub fn on_conflict_do_nothing(self, target: Node) -> Query {
    self.add(Clause.OnConflictDoNothing(target))
  }

  pub fn on_conflict_do_update(self, target: Node, assignments: List<Assignment>) -> Query {
    self.add(Clause.OnConflictDoUpdate(target, assignments))
  }

  /// Dialek diperiksa di sini, bukan di setiap emitter, supaya perilakunya
  /// sama di ketiga target.
  pub fn parse(self) -> Result<ParseResult, ParseError> {
    match self.dialect {
      None => Err(ParseError.NoDialect)
      Some(name) => if name == "postgres" {
        Query.finish(self.clauses, Dialect.Postgres)
      } else if name == "mysql" {
        Query.finish(self.clauses, Dialect.MySql)
      } else {
        Err(ParseError.UnsupportedDialect(name))
      }
    }
  }

  fn add(self, clause: Clause) -> Query {
    Query(clauses: self.clauses.push(clause), dialect: self.dialect)
  }

  static fn finish(clauses: List<Clause>, dialect: Dialect) -> Result<ParseResult, ParseError> {
    if clauses.len() == 0 {
      return Err(ParseError.EmptyQuery)
    }
    let plain = Query.render(clauses, dialect, false)
    let inlined = Query.render(clauses, dialect, true)
    Ok(
      ParseResult(
        sql: plain.text,
        param: plain.params,
        sql_with_param: inlined.text,
      ),
    )
  }

  static fn render(clauses: List<Clause>, dialect: Dialect, inline: Bool) -> Rendered {
    let mut text = ""
    let mut params: List<Value> = []
    for clause in clauses {
      let piece = Query.clause(clause, dialect, params.len(), inline)
      if text == "" {
        text = piece.text
      } else {
        text = `${text} ${piece.text}`
      }
      params = params.concat(piece.params)
    }
    Rendered(text: text, params: params)
  }

  static fn clause(clause: Clause, dialect: Dialect, base: Int, inline: Bool) -> Rendered {
    match clause {
      Clause.Select(columns) => Query.keyword(
        "SELECT",
        Renderer.list(columns, dialect, base, inline, ", "),
      )
      Clause.From(table) => Query.keyword("FROM", Renderer.expr(table, dialect, base, inline))
      Clause.Where(conditions) => Query.keyword(
        "WHERE",
        Renderer.list(conditions, dialect, base, inline, " AND "),
      )
      Clause.OrderBy(columns) => Query.keyword(
        "ORDER BY",
        Renderer.list(columns, dialect, base, inline, ", "),
      )
      Clause.Limit(count) => Query.keyword("LIMIT", Renderer.expr(count, dialect, base, inline))
      Clause.Offset(count) => Query.keyword("OFFSET", Renderer.expr(count, dialect, base, inline))
      Clause.Raw(text) => Rendered(text: text, params: [])
      Clause.Update(table, assignments) => Query.keyword(
        "UPDATE",
        Query.then(
          Renderer.expr(table, dialect, base, inline),
          Query.keyword("SET", Query.assignments(assignments, dialect, base, inline)),
        ),
      )
      Clause.Insert(table, assignments) => Query.insert_clause(
        table,
        assignments,
        dialect,
        base,
        inline,
      )
      Clause.Delete(table) => Query.keyword(
        "DELETE FROM",
        Renderer.expr(table, dialect, base, inline),
      )
      Clause.Set(assignments) => Query.keyword(
        "SET",
        Query.assignments(assignments, dialect, base, inline),
      )
      Clause.Values(rows) => Query.keyword(
        "VALUES",
        Query.rows(rows, dialect, base, inline),
      )
      Clause.Returning(columns) => Query.keyword(
        "RETURNING",
        Renderer.list(columns, dialect, base, inline, ", "),
      )
      Clause.GroupBy(columns) => Query.keyword(
        "GROUP BY",
        Renderer.list(columns, dialect, base, inline, ", "),
      )
      Clause.Having(conditions) => Query.keyword(
        "HAVING",
        Renderer.list(conditions, dialect, base, inline, " AND "),
      )
      Clause.Join(keyword, table, on) => Query.keyword(
        keyword,
        Query.then(
          Renderer.expr(table, dialect, base, inline),
          Query.keyword("ON", Renderer.list(on, dialect, base, inline, " AND ")),
        ),
      )
      Clause.OnConflictDoNothing(target) => Query.keyword(
        "ON CONFLICT",
        Query.then(
          Query.parenthesised_ident(target, dialect),
          Rendered(text: "DO NOTHING", params: []),
        ),
      )
      Clause.OnConflictDoUpdate(target, assignments) => Query.keyword(
        "ON CONFLICT",
        Query.then(
          Query.parenthesised_ident(target, dialect),
          Query.keyword(
            "DO UPDATE SET",
            Query.assignments(assignments, dialect, base, inline),
          ),
        ),
      )
    }
  }

  /// Menggabungkan dua fragmen dengan satu spasi, membawa parameter.
  static fn then(left: Rendered, right: Rendered) -> Rendered {
    Rendered(
      text: `${left.text} ${right.text}`,
      params: left.params.concat(right.params),
    )
  }

  static fn assignments(
    items: List<Assignment>,
    dialect: Dialect,
    base: Int,
    inline: Bool,
  ) -> Rendered {
    let mut text = ""
    let mut params: List<Value> = []
    for item in items {
      let column = Renderer.ident(item.column, dialect)
      let value = Renderer.expr(item.value, dialect, base + params.len(), inline)
      if text == "" {
        text = `${column} = ${value.text}`
      } else {
        text = `${text}, ${column} = ${value.text}`
      }
      params = params.concat(value.params)
    }
    Rendered(text: text, params: params)
  }

  static fn insert_clause(
    table: Node,
    items: List<Assignment>,
    dialect: Dialect,
    base: Int,
    inline: Bool,
  ) -> Rendered {
    let mut columns: List<Str> = []
    let mut values: List<Str> = []
    let mut params: List<Value> = []
    for item in items {
      columns = columns.push(Renderer.ident(item.column, dialect))
      let value = Renderer.expr(item.value, dialect, base + params.len(), inline)
      values = values.push(value.text)
      params = params.concat(value.params)
    }
    let table_text = Renderer.expr(table, dialect, base, inline)
    Rendered(
      text: `INSERT INTO ${table_text.text} ( ${columns.join(", ")} ) VALUES ( ${values.join(", ")} )`,
      params: params,
    )
  }

  static fn rows(
    rows: List<List<Node>>,
    dialect: Dialect,
    base: Int,
    inline: Bool,
  ) -> Rendered {
    let mut text = ""
    let mut params: List<Value> = []
    for row in rows {
      let items = Renderer.list(row, dialect, base + params.len(), inline, ", ")
      if text == "" {
        text = `( ${items.text} )`
      } else {
        text = `${text}, ( ${items.text} )`
      }
      params = params.concat(items.params)
    }
    Rendered(text: text, params: params)
  }

  static fn parenthesised_ident(node: Node, dialect: Dialect) -> Rendered {
    match node.kind {
      Kind.Column(name) => Rendered(text: `(${Renderer.ident(name, dialect)})`, params: [])
      Kind.Table(name) => Rendered(text: `(${Renderer.ident(name, dialect)})`, params: [])
      Kind.Raw(text) => Rendered(text: `(${text})`, params: [])
      _ => Renderer.expr(node, dialect, 0, false)
    }
  }

  static fn keyword(word: Str, rendered: Rendered) -> Rendered {
    Rendered(text: `${word} ${rendered.text}`, params: rendered.params)
  }
}
