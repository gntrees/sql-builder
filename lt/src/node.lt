import Value from "./value.lt"

/// Bentuk node query. Satu enum, bukan pohon dinamis.
pub enum Kind {
  Column(Str)
  Table(Str)
  Raw(Str)
  Lit(Value)
  Binary(Str, Node, Node)
  Between(Node, Node, Node)
  Like(Node, Node, Bool)
  InText(Node, Str)
  InList(Node, List<Node>)
  And(List<Node>)
  Or(List<Node>)
  Not(Node)
  IsNull(Node)
  IsNotNull(Node)
  Alias(Node, Str)
  Order(Node, Bool)
}

/// Node query dengan API fluent.
///
/// `Node` membungkus `Kind` supaya operator bisa ditulis sebagai method
/// (`Node.col("id").eq(Node.int(1))`), karena enum tidak boleh punya method.
pub class Node {
  kind: Kind

  pub static fn col(name: Str) -> Node {
    Node(kind: Kind.Column(name))
  }

  pub static fn table(name: Str) -> Node {
    Node(kind: Kind.Table(name))
  }

  pub static fn raw(text: Str) -> Node {
    Node(kind: Kind.Raw(text))
  }

  /// Tagged template untuk SQL mentah: `Node.of`SELECT * FROM ${"users"}`.
  /// Nilai yang diinterpolasi sudah berupa `Str` (Di-`Display`-kan compiler),
  /// jadi tidak ikut parameterisasi — berbeda dari `raw` lama yang
  /// memparameterisasi nilai non-string.
  pub static fn of(parts: List<Str>, values: List<Str>) -> Node {
    let mut text = ""
    let mut index = 0
    for part in parts {
      text = `${text}${part}`
      let value = values.get(index)
      match value {
        Some(item) => {
          text = `${text}${item}`
          index = index + 1
        }
        None => {}
      }
    }
    Node(kind: Kind.Raw(text))
  }

  pub static fn lit(value: Value) -> Node {
    Node(kind: Kind.Lit(value))
  }

  pub static fn int(value: Int) -> Node {
    Node(kind: Kind.Lit(Value.Int(value)))
  }

  pub static fn float(value: Float) -> Node {
    Node(kind: Kind.Lit(Value.Float(value)))
  }

  pub static fn str(value: Str) -> Node {
    Node(kind: Kind.Lit(Value.Str(value)))
  }

  pub static fn bool(value: Bool) -> Node {
    Node(kind: Kind.Lit(Value.Bool(value)))
  }

  pub static fn null() -> Node {
    Node(kind: Kind.Lit(Value.Null))
  }

  pub fn eq(self, other: Node) -> Node {
    Node(kind: Kind.Binary("=", self, other))
  }

  pub fn neq(self, other: Node) -> Node {
    Node(kind: Kind.Binary("<>", self, other))
  }

  pub fn gt(self, other: Node) -> Node {
    Node(kind: Kind.Binary(">", self, other))
  }

  pub fn gte(self, other: Node) -> Node {
    Node(kind: Kind.Binary(">=", self, other))
  }

  pub fn lt(self, other: Node) -> Node {
    Node(kind: Kind.Binary("<", self, other))
  }

  pub fn lte(self, other: Node) -> Node {
    Node(kind: Kind.Binary("<=", self, other))
  }

  /// Rentang inklusif: `BETWEEN $1 AND $2`.
  pub fn between(self, low: Node, high: Node) -> Node {
    Node(kind: Kind.Between(self, low, high))
  }

  pub fn like(self, pattern: Node) -> Node {
    Node(kind: Kind.Like(self, pattern, false))
  }

  pub fn ilike(self, pattern: Node) -> Node {
    Node(kind: Kind.Like(self, pattern, true))
  }

  /// Kompatibel dengan `in("1,2,3")` lama: teksnya menjadi satu parameter.
  pub fn in_text(self, text: Str) -> Node {
    Node(kind: Kind.InText(self, text))
  }

  /// `IN` dengan daftar nilai bertipe: `IN ( $1, $2 )`.
  pub fn in_list(self, values: List<Node>) -> Node {
    Node(kind: Kind.InList(self, values))
  }

  pub fn is_null(self) -> Node {
    Node(kind: Kind.IsNull(self))
  }

  pub fn is_not_null(self) -> Node {
    Node(kind: Kind.IsNotNull(self))
  }

  pub fn not(self) -> Node {
    Node(kind: Kind.Not(self))
  }

  /// Semua kondisi digabung dengan `AND`; `self` selalu di depan.
  pub fn and(self, others: List<Node>) -> Node {
    Node(kind: Kind.And(Node.prepend(self, others)))
  }

  /// Semua kondisi digabung dengan `OR`; `self` selalu di depan.
  pub fn or(self, others: List<Node>) -> Node {
    Node(kind: Kind.Or(Node.prepend(self, others)))
  }

  pub fn alias(self, name: Str) -> Node {
    Node(kind: Kind.Alias(self, name))
  }

  pub fn asc(self) -> Node {
    Node(kind: Kind.Order(self, false))
  }

  pub fn desc(self) -> Node {
    Node(kind: Kind.Order(self, true))
  }

  fn prepend(first: Node, rest: List<Node>) -> List<Node> {
    let mut items: List<Node> = [first]
    for item in rest {
      items = items.push(item)
    }
    items
  }
}
