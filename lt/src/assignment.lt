import Node from "./node.lt"

/// Satu pasangan kolom = nilai untuk `INSERT`/`UPDATE`/`SET`.
///
/// Ini pengganti `Map` dinamis di desain lama: urutan kolom mengikuti urutan
/// list, dan `value` bisa literal maupun kolom lain.
pub class Assignment {
  column: Str
  value: Node

  pub static fn of(column: Str, value: Node) -> Assignment {
    Assignment(column: column, value: value)
  }

  pub static fn int(column: Str, value: Int) -> Assignment {
    Assignment(column: column, value: Node.int(value))
  }

  pub static fn str(column: Str, value: Str) -> Assignment {
    Assignment(column: column, value: Node.str(value))
  }

  pub static fn bool(column: Str, value: Bool) -> Assignment {
    Assignment(column: column, value: Node.bool(value))
  }
}
