/// Opsi kolom yang immutable.
///
/// LT v1 tidak punya default argumen, jadi setiap opsi diisi lewat preset
/// (lihat docs/plans/drizzle-port.md, K16).
pub class ColumnOpts {
  not_null: Bool
  primary: Bool
  unique: Bool
  has_default: Bool
  default_sql: Str

  pub static fn none() -> ColumnOpts {
    ColumnOpts(
      not_null: false,
      primary: false,
      unique: false,
      has_default: false,
      default_sql: "",
    )
  }

  pub fn with_not_null(self) -> ColumnOpts {
    ColumnOpts(
      not_null: true,
      primary: self.primary,
      unique: self.unique,
      has_default: self.has_default,
      default_sql: self.default_sql,
    )
  }

  pub fn with_primary(self) -> ColumnOpts {
    ColumnOpts(
      not_null: true,
      primary: true,
      unique: self.unique,
      has_default: self.has_default,
      default_sql: self.default_sql,
    )
  }

  pub fn with_unique(self) -> ColumnOpts {
    ColumnOpts(
      not_null: self.not_null,
      primary: self.primary,
      unique: true,
      has_default: self.has_default,
      default_sql: self.default_sql,
    )
  }

  pub fn with_default(self, value: Str) -> ColumnOpts {
    ColumnOpts(
      not_null: self.not_null,
      primary: self.primary,
      unique: self.unique,
      has_default: true,
      default_sql: value,
    )
  }
}

/// Definisi satu kolom.
pub class Column {
  name: Str
  sql_type: Str
  opts: ColumnOpts

  fn base(name: Str, sql_type: Str) -> Column {
    Column(name: name, sql_type: sql_type, opts: ColumnOpts.none())
  }

  pub fn with_not_null(self) -> Column {
    Column(name: self.name, sql_type: self.sql_type, opts: self.opts.with_not_null())
  }

  pub fn with_primary(self) -> Column {
    Column(name: self.name, sql_type: self.sql_type, opts: self.opts.with_primary())
  }

  pub fn with_unique(self) -> Column {
    Column(name: self.name, sql_type: self.sql_type, opts: self.opts.with_unique())
  }

  pub fn with_default(self, value: Str) -> Column {
    Column(name: self.name, sql_type: self.sql_type, opts: self.opts.with_default(value))
  }

  pub static fn integer(name: Str) -> Column {
    Column.base(name, "integer")
  }

  pub static fn serial(name: Str) -> Column {
    Column.base(name, "serial")
  }

  pub static fn bigint(name: Str) -> Column {
    Column.base(name, "bigint")
  }

  pub static fn text(name: Str) -> Column {
    Column.base(name, "text")
  }

  pub static fn varchar(name: Str, length: Int) -> Column {
    Column.base(name, `varchar(${length})`)
  }

  pub static fn char(name: Str, length: Int) -> Column {
    Column.base(name, `char(${length})`)
  }

  pub static fn boolean(name: Str) -> Column {
    Column.base(name, "boolean")
  }

  pub static fn timestamp(name: Str) -> Column {
    Column.base(name, "timestamp")
  }

  pub static fn date(name: Str) -> Column {
    Column.base(name, "date")
  }

  pub static fn time(name: Str) -> Column {
    Column.base(name, "time")
  }

  pub static fn real(name: Str) -> Column {
    Column.base(name, "real")
  }

  pub static fn double(name: Str) -> Column {
    Column.base(name, "double precision")
  }

  pub static fn numeric(name: Str, precision: Int, scale: Int) -> Column {
    Column.base(name, `numeric(${precision}, ${scale})`)
  }

  pub static fn json(name: Str) -> Column {
    Column.base(name, "json")
  }

  pub static fn jsonb(name: Str) -> Column {
    Column.base(name, "jsonb")
  }

  pub static fn uuid(name: Str) -> Column {
    Column.base(name, "uuid")
  }

  pub static fn custom(name: Str, sql_type: Str) -> Column {
    Column.base(name, sql_type)
  }
}
