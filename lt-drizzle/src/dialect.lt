import Value from "./value.lt"
import Rendered from "./value.lt"
import Sql from "./sql.lt"
import SqlChunk from "./sql.lt"

/// Aturan per-target yang harus persis mengikuti drizzle 0.44.4.
pub class Dialect {
  kind: Str

  pub static fn postgres() -> Dialect {
    Dialect(kind: "postgres")
  }

  pub static fn mysql() -> Dialect {
    Dialect(kind: "mysql")
  }

  pub static fn sqlite() -> Dialect {
    Dialect(kind: "sqlite")
  }

  /// Karakter quote identifier per dialect.
  pub fn quote_char(self) -> Str {
    if self.kind == "mysql" {
      "`"
    } else {
      "\""
    }
  }

  /// Bungkus identifier.
  ///
  /// Drizzle 0.44.4 **tidak** meng-escape karakter quote di dalam identifier
  /// (`sql.identifier('we"ird')` menghasilkan `"we"ird"`). Port ini meniru
  /// perilaku itu apa adanya, karena kontraknya adalah output yang identik,
  /// bukan output yang lebih benar. Perbaikan escaping adalah keputusan
  /// terpisah yang harus mengubah kedua sisi sekaligus.
  pub fn quote_identifier(self, name: Str) -> Str {
    if self.kind == "mysql" {
      `\`${name}\``
    } else {
      `"${name}"`
    }
  }

  /// Deparse menjadi teks SQL + daftar parameter.
  pub fn sql_to_query(self, sql: Sql) -> Rendered {
    let mut text = ""
    let mut params: List<Value> = []
    for chunk in sql.chunks {
      match chunk {
        SqlChunk.Raw(part) => {
          text = `${text}${part}`
        }
        SqlChunk.Ident(name) => {
          text = `${text}${self.quote_identifier(name)}`
        }
        SqlChunk.Param(value) => {
          params = params.push(value)
          if self.kind == "postgres" {
            text = `${text}$${params.len()}`
          } else {
            text = `${text}?`
          }
        }
      }
    }
    Rendered(sql: text, params: params)
  }
}
