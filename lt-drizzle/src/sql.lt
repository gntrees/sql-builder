import Value from "./value.lt"
import SqlArg from "./value.lt"

/// Potongan SQL. Chunk selalu rata (tidak ada `Nested`), sehingga tipe tidak
/// rekursif lewat field class; tanda kurung ditulis sebagai `Raw`.
pub enum SqlChunk {
  Raw(Str)
  Param(Value)
  Ident(Str)
}

/// Ekspresi SQL yang belum di-deparse.
pub class Sql {
  chunks: List<SqlChunk>

  pub static fn raw(text: Str) -> Sql {
    Sql(chunks: [SqlChunk.Raw(text)])
  }

  pub static fn empty() -> Sql {
    Sql(chunks: [])
  }

  pub static fn param(value: Value) -> Sql {
    Sql(chunks: [SqlChunk.Param(value)])
  }

  pub static fn identifier(name: Str) -> Sql {
    Sql(chunks: [SqlChunk.Ident(name)])
  }

  pub static fn int(value: Int) -> Sql {
    Sql(chunks: [SqlChunk.Param(Value.Int(value))])
  }

  pub static fn float(value: Float) -> Sql {
    Sql(chunks: [SqlChunk.Param(Value.Float(value))])
  }

  pub static fn str(value: Str) -> Sql {
    Sql(chunks: [SqlChunk.Param(Value.Str(value))])
  }

  pub static fn bool(value: Bool) -> Sql {
    Sql(chunks: [SqlChunk.Param(Value.Bool(value))])
  }

  pub static fn null_value() -> Sql {
    Sql(chunks: [SqlChunk.Param(Value.Null)])
  }

  /// Padanan `sql` tag drizzle.
  pub static fn template(parts: List<Str>, values: List<SqlArg>) -> Sql {
    let mut chunks: List<SqlChunk> = []
    let mut index = 0
    for part in parts {
      chunks = chunks.push(SqlChunk.Raw(part))
      match values.get(index) {
        Some(arg) => {
          chunks = chunks.push(SqlChunk.Param(Sql.arg_to_value(arg)))
        }
        None => {}
      }
      index = index + 1
    }
    Sql(chunks: chunks)
  }

  fn arg_to_value(arg: SqlArg) -> Value {
    match arg {
      SqlArg.Null => Value.Null
      SqlArg.Bool(value) => Value.Bool(value)
      SqlArg.Int(value) => Value.Int(value)
      SqlArg.Float(value) => Value.Float(value)
      SqlArg.Str(value) => Value.Str(value)
    }
  }

  pub fn append(self, other: Sql) -> Sql {
    Sql(chunks: self.chunks.concat(other.chunks))
  }

  pub fn is_empty(self) -> Bool {
    self.chunks.len() == 0
  }

  /// Gabungkan beberapa ekspresi dengan pemisah.
  pub static fn join(items: List<Sql>, separator: Str) -> Sql {
    let mut result = Sql.empty()
    let mut first = true
    for item in items {
      if first {
        result = result.append(item)
        first = false
      } else {
        result = result.append(Sql.raw(separator)).append(item)
      }
    }
    result
  }

  fn binary(self, operator: Str, other: Sql) -> Sql {
    self.append(Sql.raw(` ${operator} `)).append(other)
  }

  pub fn eq(self, other: Sql) -> Sql {
    self.binary("=", other)
  }

  pub fn ne(self, other: Sql) -> Sql {
    self.binary("<>", other)
  }

  pub fn gt(self, other: Sql) -> Sql {
    self.binary(">", other)
  }

  pub fn gte(self, other: Sql) -> Sql {
    self.binary(">=", other)
  }

  pub fn lt(self, other: Sql) -> Sql {
    self.binary("<", other)
  }

  pub fn lte(self, other: Sql) -> Sql {
    self.binary("<=", other)
  }

  pub fn like(self, other: Sql) -> Sql {
    self.binary("like", other)
  }

  pub fn not_like(self, other: Sql) -> Sql {
    self.binary("not like", other)
  }

  pub fn ilike(self, other: Sql) -> Sql {
    self.binary("ilike", other)
  }

  pub fn not_ilike(self, other: Sql) -> Sql {
    self.binary("not ilike", other)
  }

  pub fn in_list(self, items: List<Sql>) -> Sql {
    if items.len() == 0 {
      Sql.raw("false")
    } else {
      self.binary("in", Sql.raw("(").append(Sql.join(items, ", ")).append(Sql.raw(")")))
    }
  }

  pub fn not_in_list(self, items: List<Sql>) -> Sql {
    if items.len() == 0 {
      Sql.raw("true")
    } else {
      self.binary("not in", Sql.raw("(").append(Sql.join(items, ", ")).append(Sql.raw(")")))
    }
  }

  pub fn between(self, low: Sql, high: Sql) -> Sql {
    self.append(Sql.raw(" between ")).append(low).append(Sql.raw(" and ")).append(high)
  }

  pub fn not_between(self, low: Sql, high: Sql) -> Sql {
    self.append(Sql.raw(" not between ")).append(low).append(Sql.raw(" and ")).append(high)
  }

  pub fn is_null(self) -> Sql {
    self.append(Sql.raw(" is null"))
  }

  pub fn is_not_null(self) -> Sql {
    self.append(Sql.raw(" is not null"))
  }

  pub fn asc(self) -> Sql {
    self.append(Sql.raw(" asc"))
  }

  pub fn desc(self) -> Sql {
    self.append(Sql.raw(" desc"))
  }

  pub fn as_alias(self, alias: Str) -> Sql {
    self.append(Sql.raw(" as ")).append(Sql.identifier(alias))
  }

  pub static fn and(items: List<Sql>) -> Sql {
    if items.len() == 0 {
      Sql.empty()
    } else {
      Sql.raw("(").append(Sql.join(items, " and ")).append(Sql.raw(")"))
    }
  }

  pub static fn or(items: List<Sql>) -> Sql {
    if items.len() == 0 {
      Sql.empty()
    } else {
      Sql.raw("(").append(Sql.join(items, " or ")).append(Sql.raw(")"))
    }
  }

  pub static fn not(expr: Sql) -> Sql {
    Sql.raw("not ").append(expr)
  }

  fn call(name: Str, argument: Sql) -> Sql {
    Sql.raw(name).append(Sql.raw("(")).append(argument).append(Sql.raw(")"))
  }

  pub static fn count(expr: Sql) -> Sql {
    Sql.call("count", expr)
  }

  pub static fn count_all() -> Sql {
    Sql.raw("count(*)")
  }

  pub static fn sum(expr: Sql) -> Sql {
    Sql.call("sum", expr)
  }

  pub static fn avg(expr: Sql) -> Sql {
    Sql.call("avg", expr)
  }

  pub static fn min(expr: Sql) -> Sql {
    Sql.call("min", expr)
  }

  pub static fn max(expr: Sql) -> Sql {
    Sql.call("max", expr)
  }
}
