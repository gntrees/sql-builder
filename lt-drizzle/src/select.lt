import Sql from "./sql.lt"
import Table from "./table.lt"
import Dialect from "./dialect.lt"
import Rendered from "./value.lt"
import BuildError from "./value.lt"

/// Satu klausa join.
pub class Join {
  kind: Str
  table: Table
  on_expr: Sql

  pub static fn of(kind: Str, table: Table, on_expr: Sql) -> Join {
    Join(kind: kind, table: table, on_expr: on_expr)
  }
}

/// Builder SELECT yang immutable.
///
/// Drizzle memakai `db.select()`; port ini tidak punya `db` (tidak ada IO),
/// jadi entry point-nya factory statis (lihat docs/plans/drizzle-port.md, K18).
pub class Select {
  table: Option<Table>
  subquery: Option<Select>
  subquery_alias: Str
  joins: List<Join>
  cte_names: List<Str>
  cte_queries: List<Select>
  fields: List<Sql>
  where_clause: Option<Sql>
  group_fields: List<Sql>
  having_clause: Option<Sql>
  order_fields: List<Sql>
  limit_value: Option<Int>
  offset_value: Option<Int>
  distinct_rows: Bool
  dialect: Option<Dialect>
  set_operator: Str
  set_query: Option<Select>

  pub static fn create() -> Select {
    Select(
      table: None,
      subquery: None,
      subquery_alias: "",
      joins: [],
      cte_names: [],
      cte_queries: [],
      fields: [],
      where_clause: None,
      group_fields: [],
      having_clause: None,
      order_fields: [],
      limit_value: None,
      offset_value: None,
      distinct_rows: false,
      dialect: None,
      set_operator: "",
      set_query: None,
    )
  }
  pub fn from_table(self, table: Table) -> Select {
    Select(
      table: Some(table),
      subquery: None,
      subquery_alias: self.subquery_alias,
      joins: self.joins,
      cte_names: self.cte_names,
      cte_queries: self.cte_queries,
      fields: self.fields,
      where_clause: self.where_clause,
      group_fields: self.group_fields,
      having_clause: self.having_clause,
      order_fields: self.order_fields,
      limit_value: self.limit_value,
      offset_value: self.offset_value,
      distinct_rows: self.distinct_rows,
      dialect: self.dialect,
      set_operator: self.set_operator,
      set_query: self.set_query,
    )
  }
  pub fn from_subquery(self, query: Select, alias: Str) -> Select {
    Select(
      table: None,
      subquery: Some(query),
      subquery_alias: alias,
      joins: self.joins,
      cte_names: self.cte_names,
      cte_queries: self.cte_queries,
      fields: self.fields,
      where_clause: self.where_clause,
      group_fields: self.group_fields,
      having_clause: self.having_clause,
      order_fields: self.order_fields,
      limit_value: self.limit_value,
      offset_value: self.offset_value,
      distinct_rows: self.distinct_rows,
      dialect: self.dialect,
      set_operator: self.set_operator,
      set_query: self.set_query,
    )
  }
  pub fn left_join(self, table: Table, on_expr: Sql) -> Select {
    Select(
      table: self.table,
      subquery: self.subquery,
      subquery_alias: self.subquery_alias,
      joins: self.joins.push(Join.of("left", table, on_expr)),
      cte_names: self.cte_names,
      cte_queries: self.cte_queries,
      fields: self.fields,
      where_clause: self.where_clause,
      group_fields: self.group_fields,
      having_clause: self.having_clause,
      order_fields: self.order_fields,
      limit_value: self.limit_value,
      offset_value: self.offset_value,
      distinct_rows: self.distinct_rows,
      dialect: self.dialect,
      set_operator: self.set_operator,
      set_query: self.set_query,
    )
  }
  pub fn inner_join(self, table: Table, on_expr: Sql) -> Select {
    Select(
      table: self.table,
      subquery: self.subquery,
      subquery_alias: self.subquery_alias,
      joins: self.joins.push(Join.of("inner", table, on_expr)),
      cte_names: self.cte_names,
      cte_queries: self.cte_queries,
      fields: self.fields,
      where_clause: self.where_clause,
      group_fields: self.group_fields,
      having_clause: self.having_clause,
      order_fields: self.order_fields,
      limit_value: self.limit_value,
      offset_value: self.offset_value,
      distinct_rows: self.distinct_rows,
      dialect: self.dialect,
      set_operator: self.set_operator,
      set_query: self.set_query,
    )
  }
  pub fn right_join(self, table: Table, on_expr: Sql) -> Select {
    Select(
      table: self.table,
      subquery: self.subquery,
      subquery_alias: self.subquery_alias,
      joins: self.joins.push(Join.of("right", table, on_expr)),
      cte_names: self.cte_names,
      cte_queries: self.cte_queries,
      fields: self.fields,
      where_clause: self.where_clause,
      group_fields: self.group_fields,
      having_clause: self.having_clause,
      order_fields: self.order_fields,
      limit_value: self.limit_value,
      offset_value: self.offset_value,
      distinct_rows: self.distinct_rows,
      dialect: self.dialect,
      set_operator: self.set_operator,
      set_query: self.set_query,
    )
  }
  pub fn full_join(self, table: Table, on_expr: Sql) -> Select {
    Select(
      table: self.table,
      subquery: self.subquery,
      subquery_alias: self.subquery_alias,
      joins: self.joins.push(Join.of("full", table, on_expr)),
      cte_names: self.cte_names,
      cte_queries: self.cte_queries,
      fields: self.fields,
      where_clause: self.where_clause,
      group_fields: self.group_fields,
      having_clause: self.having_clause,
      order_fields: self.order_fields,
      limit_value: self.limit_value,
      offset_value: self.offset_value,
      distinct_rows: self.distinct_rows,
      dialect: self.dialect,
      set_operator: self.set_operator,
      set_query: self.set_query,
    )
  }
  pub fn with_cte(self, name: Str, query: Select) -> Select {
    Select(
      table: self.table,
      subquery: self.subquery,
      subquery_alias: self.subquery_alias,
      joins: self.joins,
      cte_names: self.cte_names.push(name),
      cte_queries: self.cte_queries.push(query),
      fields: self.fields,
      where_clause: self.where_clause,
      group_fields: self.group_fields,
      having_clause: self.having_clause,
      order_fields: self.order_fields,
      limit_value: self.limit_value,
      offset_value: self.offset_value,
      distinct_rows: self.distinct_rows,
      dialect: self.dialect,
      set_operator: self.set_operator,
      set_query: self.set_query,
    )
  }
