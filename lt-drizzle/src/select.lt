  /// Bangun menjadi SQL + params.
  pub fn build(self) -> Result<Rendered, BuildError> {
    match self.dialect {
      None => Err(BuildError.MissingDialect)
      Some(dialect) => Ok(dialect.sql_to_query(self.to_sql()))
    }
  }

  /// `exists (select ...)`.
  pub static fn exists(query: Select) -> Sql {
    Sql.raw("exists (").append(query.to_sql()).append(Sql.raw(")"))
  }

  pub static fn not_exists(query: Select) -> Sql {
    Sql.raw("not exists (").append(query.to_sql()).append(Sql.raw(")"))
  }

  /// `expr in (select ...)`.
  pub static fn in_subquery(expr: Sql, query: Select) -> Sql {
    expr.append(Sql.raw(" in (")).append(query.to_sql()).append(Sql.raw(")"))
  }

  /// Referensi kolom milik subquery/CTE ber-alias.
  pub static fn ref(alias: Str, column: Str) -> Sql {
    Sql.identifier(alias).append(Sql.raw(".")).append(Sql.identifier(column))
  }

  pub fn to_sql(self) -> Sql {
    let body = self.body_sql()
    let mut result = match self.set_query {
      Some(query) => {
        Sql.raw("(")
          .append(body)
          .append(Sql.raw(")"))
          .append(Sql.raw(` ${self.set_operator} `))
          .append(Sql.raw("("))
          .append(query.to_sql())
          .append(Sql.raw(")"))
      }
      None => body
    }
    if self.cte_names.len() > 0 {
      let mut parts: List<Sql> = []
      let mut index = 0
      for name in self.cte_names {
        let query = self.cte_queries.get(index).unwrap()
        parts = parts.push(
          Sql.identifier(name)
            .append(Sql.raw(" as ("))
            .append(query.to_sql())
            .append(Sql.raw(")")),
        )
        index = index + 1
      }
      result = Sql.raw("with ")
        .append(Sql.join(parts, ", "))
        .append(Sql.raw(" "))
        .append(result)
    }
    result
  }

  fn body_sql(self) -> Sql {
    let fields = if self.fields.len() == 0 {
      match self.table {
        Some(table) => table.fields()
        None => self.fields
      }
    } else {
      self.fields
    }
    let mut sql = Sql.raw("select ")
    if self.distinct_rows {
      sql = sql.append(Sql.raw("distinct "))
    }
    sql = sql.append(Sql.join(fields, ", ")).append(Sql.raw(" from "))

    match self.table {
      Some(table) => {
        sql = sql.append(table.from_ref())
      }
      None => {
        match self.subquery {
          Some(query) => {
            sql = sql
              .append(Sql.raw("("))
              .append(query.to_sql())
              .append(Sql.raw(") "))
              .append(Sql.identifier(self.subquery_alias))
          }
          None => {}
        }
      }
    }

    for join in self.joins {
      sql = sql
        .append(Sql.raw(` ${join.kind} join `))
        .append(join.table.from_ref())
        .append(Sql.raw(" on "))
        .append(join.on_expr)
    }

    match self.where_clause {
      Some(expr) => {
        if !expr.is_empty() {
          sql = sql.append(Sql.raw(" where ")).append(expr)
        }
      }
      None => {}
    }

    if self.group_fields.len() > 0 {
      sql = sql
        .append(Sql.raw(" group by "))
        .append(Sql.join(self.group_fields, ", "))
    }

    match self.having_clause {
      Some(expr) => {
        if !expr.is_empty() {
          sql = sql.append(Sql.raw(" having ")).append(expr)
        }
      }
      None => {}
    }

    if self.order_fields.len() > 0 {
      sql = sql
        .append(Sql.raw(" order by "))
        .append(Sql.join(self.order_fields, ", "))
    }

    match self.limit_value {
      Some(value) => {
        sql = sql.append(Sql.raw(" limit ")).append(Sql.int(value))
      }
      None => {}
    }

    match self.offset_value {
      Some(value) => {
        sql = sql.append(Sql.raw(" offset ")).append(Sql.int(value))
      }
      None => {}
    }

    sql
  }
}
