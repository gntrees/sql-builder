import Sql from "./sql.lt"

/// Satu pasangan kolom = nilai untuk `insert`/`update`.
pub class Assignment {
  column: Str
  value: Sql

  pub static fn of(column: Str, value: Sql) -> Assignment {
    Assignment(column: column, value: value)
  }

  pub fn to_sql(self) -> Sql {
    Sql.identifier(self.column).append(Sql.raw(" = ")).append(self.value)
  }
}
