import Sql from "./sql.lt"
import Table from "./table.lt"
import Dialect from "./dialect.lt"
import Rendered from "./value.lt"
import BuildError from "./value.lt"
import Assignment from "./assignment.lt"

/// Builder UPDATE.
pub class Update {
  table: Option<Table>
  assignments: List<Assignment>
  where_clause: Option<Sql>
  returning_fields: List<Sql>
  returning_all: Bool
  dialect: Option<Dialect>

  pub static fn create(table: Table) -> Update {
    Update(
      table: Some(table),
      assignments: [],
      where_clause: None,
      returning_fields: [],
      returning_all: false,
      dialect: None,
    )
  }

  fn copy(
    self,
    assignments: List<Assignment>,
    where_clause: Option<Sql>,
    returning_fields: List<Sql>,
    returning_all: Bool,
    dialect: Option<Dialect>,
  ) -> Update {
    Update(
      table: self.table,
      assignments: assignments,
      where_clause: where_clause,
      returning_fields: returning_fields,
      returning_all: returning_all,
      dialect: dialect,
    )
  }

  pub fn set(self, assignments: List<Assignment>) -> Update {
    self.copy(assignments, self.where_clause, self.returning_fields, self.returning_all, self.dialect)
  }

  pub fn where(self, expr: Sql) -> Update {
    self.copy(self.assignments, Some(expr), self.returning_fields, self.returning_all, self.dialect)
  }

  pub fn returning(self, fields: List<Sql>) -> Update {
    self.copy(self.assignments, self.where_clause, fields, false, self.dialect)
  }

  pub fn returning_all_columns(self) -> Update {
    self.copy(self.assignments, self.where_clause, [], true, self.dialect)
  }

  pub fn set_dialect(self, dialect: Dialect) -> Update {
    self.copy(self.assignments, self.where_clause, self.returning_fields, self.returning_all, Some(dialect))
  }

  pub fn build(self) -> Result<Rendered, BuildError> {
    match self.dialect {
      None => Err(BuildError.MissingDialect)
      Some(dialect) => {
        match self.table {
          None => Err(BuildError.MissingTable)
          Some(table) => Ok(dialect.sql_to_query(self.to_sql(table)))
        }
      }
    }
  }

  fn to_sql(self, table: Table) -> Sql {
    let mut sql = Sql.raw("update ")
      .append(table.from_ref())
      .append(Sql.raw(" set "))
      .append(Sql.join(self.assignments.map(fn(item) => item.to_sql()), ", "))

    match self.where_clause {
      Some(expr) => {
        if !expr.is_empty() {
          sql = sql.append(Sql.raw(" where ")).append(expr)
        }
      }
      None => {}
    }

    let returned = if self.returning_all {
      table.columns.map(fn(column) => Sql.identifier(column.name))
    } else {
      self.returning_fields
    }
    if returned.len() > 0 {
      sql = sql.append(Sql.raw(" returning ")).append(Sql.join(returned, ", "))
    }

    sql
  }
}
