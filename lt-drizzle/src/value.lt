/// Nilai portabel yang boleh muncul sebagai parameter query.
///
/// Hanya tipe yang bisa dipetakan ke semua target tanpa kehilangan makna.
/// `Date`, `JSON` bertipe, dan `Buffer` sengaja tidak ada: konversinya
/// tanggung jawab host (lihat docs/plans/drizzle-port.md, K13).
pub enum Value {
  Null
  Bool(Bool)
  Int(Int)
  Float(Float)
  Str(Str)
  List(List<Value>)
  Map(Map<Str, Value>)
}

/// Nilai yang boleh masuk lewat tagged template `Sql.template`.
///
/// `T` pada tagged template harus konkret dan tidak boleh memakai type
/// parameter class, jadi tipe campuran dinyatakan dengan enum ini. Setiap
/// interpolasi harus dibungkus eksplisit (`${SqlArg.Int(id)}`).
pub enum SqlArg {
  Null
  Bool(Bool)
  Int(Int)
  Float(Float)
  Str(Str)
}

/// Kegagalan build yang harus dilaporkan, bukan ditelan.
pub enum BuildError {
  Unsupported(Str, Str)
  MissingDialect
  UnknownColumn(Str, Str)
}

/// Hasil deparse satu query.
pub class Rendered {
  sql: Str
  params: List<Value>
}
