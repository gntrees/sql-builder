import Sql from "./sql.lt"
import Column from "./column.lt"

/// Definisi tabel: nama SQL, schema opsional, alias opsional, dan kolom.
///
/// `Table` membangun potongan SQL sendiri supaya `sql.lt` tidak perlu
/// mengimpor `Table` (import melingkar dilarang di LT). Chunk tetap hanya
/// `Raw`/`Ident`/`Param`.
pub class Table {
  name: Str
  schema: Option<Str>
  alias: Option<Str>
  columns: List<Column>

  pub static fn define(
    name: Str,
    schema: Option<Str>,
    alias: Option<Str>,
    columns: List<Column>,
  ) -> Table {
    Table(name: name, schema: schema, alias: alias, columns: columns)
  }

  /// Kasus umum tanpa schema/alias (menghindari `Option` di API host).
  pub static fn plain(name: Str, columns: List<Column>) -> Table {
    Table.define(name, None, None, columns)
  }

  pub static fn with_schema(name: Str, schema: Str, columns: List<Column>) -> Table {
    Table.define(name, Some(schema), None, columns)
  }

  pub static fn with_alias(name: Str, alias: Str, columns: List<Column>) -> Table {
    Table.define(name, None, Some(alias), columns)
  }

  pub static fn with_schema_alias(
    name: Str,
    schema: Str,
    alias: Str,
    columns: List<Column>,
  ) -> Table {
    Table.define(name, Some(schema), Some(alias), columns)
  }

  /// Nama yang dipakai untuk mengkualifikasi kolom.
  pub fn label(self) -> Str {
    match self.alias {
      Some(value) => value
      None => self.name
    }
  }

  pub fn has_column(self, name: Str) -> Bool {
    let mut found = false
    for column in self.columns {
      if column.name == name {
        found = true
      }
    }
    found
  }

  /// Referensi kolom, mis. `"users"."id"` atau `"auth"."users"."id"`.
  pub fn col(self, name: Str) -> Sql {
    self.ref().append(Sql.raw(".")).append(Sql.identifier(name))
  }

  /// Referensi tabel di luar klausa `from`.
  ///
  /// Drizzle merender alias sebagai `"u"` saja di sini.
  pub fn ref(self) -> Sql {
    match self.alias {
      Some(value) => Sql.identifier(value)
      None => {
        match self.schema {
          Some(value) => {
            Sql.identifier(value).append(Sql.raw(".")).append(Sql.identifier(self.name))
          }
          None => Sql.identifier(self.name)
        }
      }
    }
  }

  /// Referensi tabel untuk klausa `from`.
  ///
  /// Drizzle merender alias di `from` sebagai `"users" "u"` (nama asli lalu
  /// alias), berbeda dari `ref()`.
  pub fn from_ref(self) -> Sql {
    match self.alias {
      Some(value) => {
        Sql.identifier(self.name).append(Sql.raw(" ")).append(Sql.identifier(value))
      }
      None => self.ref()
    }
  }
}
