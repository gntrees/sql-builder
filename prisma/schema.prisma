generator ltSchema {
  provider     = "bun ./schema/prisma-generator.mjs"
  output       = "../schema"
  ignoreTables = "schema_migrations"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model authors {
  id   Int    @id @default(autoincrement())
  name String

  @@schema("public")
}

model b {
  id Int     @id @default(autoincrement())
  ok Boolean @default(false)

  @@schema("public")
}

model books {
  book_id   Int    @id @default(autoincrement())
  author_id Int
  title     String

  @@schema("public")
}

model m {
  id  Int @id @default(autoincrement())
  uid Int

  @@schema("public")
}

model members {
  id  Int @id @default(autoincrement())
  uid Int

  @@schema("public")
}

model orders {
  id      Int @id @default(autoincrement())
  user_id Int
  total   Int

  @@schema("public")
}

model posts {
  id      Int    @id @default(autoincrement())
  user_id Int
  title   String

  @@schema("public")
}

model schema_migrations {
  version String @id @db.VarChar

  @@schema("public")
}

model t {
  id   Int     @id @default(autoincrement())
  x    Int?
  name String?
  a    Int?
  b    Int?

  @@schema("public")
}

model u {
  id Int  @id @default(autoincrement())
  b  Int?

  @@schema("public")
}

model users {
  id     Int     @id @default(autoincrement())
  name   String
  active Boolean @default(false)
  age    Int?

  @@schema("public")
}
