generator ltSchema {
  provider     = "bun ./schema/prisma-generator.mjs"
  output       = "../schema"
  ignoreTables = "schema_migrations"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

model authors {
  id    Int     @id @default(autoincrement())
  name  String
  books books[]

  @@schema("public")
}

model b {
  id Int     @id @default(autoincrement())
  ok Boolean @default(false)

  @@schema("public")
}

model books {
  book_id   Int     @id @default(autoincrement())
  author_id Int
  title     String
  authors   authors @relation(fields: [author_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("public")
}

model m {
  id  Int @id @default(autoincrement())
  uid Int

  @@schema("public")
}

model members {
  id  Int @id @default(autoincrement())
  uid Int

  @@schema("public")
}

model orders {
  id      Int   @id @default(autoincrement())
  user_id Int
  total   Int
  users   users @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("public")
}

model posts {
  id      Int    @id @default(autoincrement())
  user_id Int
  title   String
  users   users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

model schema_migrations {
  version String @id @db.VarChar

  @@schema("public")
}

model t {
  id   Int     @id @default(autoincrement())
  x    Int?
  name String?
  a    Int?
  b    Int?

  @@schema("public")
}

model u {
  id Int  @id @default(autoincrement())
  b  Int?

  @@schema("public")
}

model users {
  id     Int       @id @default(autoincrement())
  name   String
  active Boolean   @default(false)
  age    Int?
  email  String?   @unique @db.VarChar(320)
  role   user_role @default(user)
  orders orders[]
  posts  posts[]

  @@schema("public")
}

enum user_role {
  admin
  user

  @@schema("public")
}
