import sql { Sql } "./sql.lt"
import schema { Table } "./schema.lt"
import dialect { Dialect } "./dialect.lt"
import support "./support.lt"
import pg_core "./pg_core.lt"
import select { Select } "./select.lt"

package case_set_intersect {
  fn t() -> Table {
    schema.plain("users", [pg_core.serial("id"), pg_core.text("name"), pg_core.integer("age")])
  }
  fn p() -> Table {
    schema.plain("posts", [pg_core.serial("id"), pg_core.integer("user_id"), pg_core.text("title")])
  }
  fn q() -> Select {
    let tb = t()
    let other = p()
    select.intersect(select.fields(select.from_table(select.create(), tb), [schema.field(tb, "id")]), select.fields(select.from_table(select.create(), other), [schema.field(other, "id")]))
  }

  test "postgres" {
    expect.not_equal(support.render(dialect.postgres(), select.to_sql(select.set_dialect(q(), dialect.postgres()))), "")
  }
}
