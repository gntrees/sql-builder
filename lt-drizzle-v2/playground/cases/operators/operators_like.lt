import sql { Sql } "./sql.lt"
import schema { Table } "./schema.lt"
import dialect { Dialect } "./dialect.lt"
import support "./support.lt"
import pg_core "./pg_core.lt"
import select { Select } "./select.lt"

package case_operators_like {
  fn t() -> Table {
    schema.plain("users", [pg_core.serial("id"), pg_core.text("name"), pg_core.integer("age")])
  }
  fn q() -> Select {
    let tb = t()
    select.where(select.fields(select.from_table(select.create(), tb), [schema.field(tb, "id")]), sql.and([sql.like(schema.col(tb, "name"), sql.str("A%")), sql.not_like(schema.col(tb, "name"), sql.str("B%")), sql.ilike(schema.col(tb, "name"), sql.str("a%")), sql.not_ilike(schema.col(tb, "name"), sql.str("b%"))]))
  }

  test "postgres" {
    expect.not_equal(support.render(dialect.postgres(), select.to_sql(q())), "")
  }
  test "mysql" {
    expect.not_equal(support.render(dialect.mysql(), select.to_sql(q())), "")
  }
  test "sqlite" {
    expect.not_equal(support.render(dialect.sqlite(), select.to_sql(q())), "")
  }
}
