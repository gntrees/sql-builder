      offset_value: s.offset_value,
      distinct_rows: s.distinct_rows,
      dialect: s.dialect,
      set_operator: "except",
      set_query: Some(query),
    )
  }

  export fn build(s: Select) -> Result<Rendered, BuildError> {
    match s.dialect {
      None => Err(BuildError.MissingDialect)
      Some(d) => Ok(sql_to_query(d, to_sql(s)))
    }
  }

  /// `exists (select ...)`.
  export fn exists(query: Select) -> Sql {
    append(append(raw("exists ("), to_sql(query)), raw(")"))
  }

  export fn not_exists(query: Select) -> Sql {
    append(append(raw("not exists ("), to_sql(query)), raw(")"))
  }

  export fn in_subquery(expr: Sql, query: Select) -> Sql {
    append(append(append(expr, raw(" in (")), to_sql(query)), raw(")"))
  }

  export fn ref(alias: Str, column: Str) -> Sql {
    append(append(identifier(alias), raw(".")), identifier(column))
  }

  export fn to_sql(s: Select) -> Sql {
    let body = body_sql(s)
    let mut wrap = true
    match s.dialect {
      Some(d) => {
        if d.kind == "sqlite" {
          wrap = false
        }
      }
      None => {}
    }
    let mut result = match s.set_query {
      Some(query) => {
        if wrap {
          append(
            append(
              append(
                append(append(raw("("), body), raw(")")),
                raw(` ${s.set_operator} `),
              ),
              raw("("),
            ),
            append(to_sql(query), raw(")")),
          )
        } else {
          append(append(body, raw(` ${s.set_operator} `)), to_sql(query))
        }
      }
      None => body
    }
    if s.cte_names.len() > 0 {
      let mut parts: List<Sql> = []
      let mut index = 0
      for name in s.cte_names {
        let query = s.cte_queries.get(index).unwrap()
        parts = parts.push(
          append(
            append(append(identifier(name), raw(" as (")), to_sql(query)),
            raw(")"),
          ),
        )
        index = index + 1
      }
      result = append(
        append(append(raw("with "), join(parts, ", ")), raw(" ")),
        result,
      )
    }
    result
  }

  fn body_sql(s: Select) -> Sql {
    let mut sql = raw("select ")
    if s.distinct_rows {
      sql = append(sql, raw("distinct "))
    }
    let selected = if s.select_fields.len() == 0 {
      match s.table {
        Some(table) => schema.fields(table)
        None => s.select_fields
      }
    } else {
      s.select_fields
    }
    sql = append(append(sql, join(selected, ", ")), raw(" from "))

    match s.table {
      Some(table) => {
        sql = append(sql, schema.from_ref(table))
      }
      None => {
        match s.subquery {
          Some(query) => {
            sql = append(
              append(append(append(sql, raw("(")), to_sql(query)), raw(") ")),
              identifier(s.subquery_alias),
            )
          }
          None => {}
        }
      }
    }

    for item in s.joins {
      sql = append(
        append(
          append(append(sql, raw(` ${item.kind} join `)), schema.from_ref(item.table)),
          raw(" on "),
        ),
        item.on_expr,
      )
    }

    match s.where_clause {
      Some(expr) => {
        if !is_empty(expr) {
          sql = append(append(sql, raw(" where ")), expr)
        }
      }
      None => {}
    }

    if s.group_fields.len() > 0 {
      sql = append(append(sql, raw(" group by ")), join(s.group_fields, ", "))
    }

    match s.having_clause {
      Some(expr) => {
        if !is_empty(expr) {
          sql = append(append(sql, raw(" having ")), expr)
        }
      }
      None => {}
    }

    if s.order_fields.len() > 0 {
      sql = append(append(sql, raw(" order by ")), join(s.order_fields, ", "))
    }

    match s.limit_value {
      Some(value) => {
        sql = append(append(sql, raw(" limit ")), int(value))
      }
      None => {}
    }

    match s.offset_value {
      Some(value) => {
        sql = append(append(sql, raw(" offset ")), int(value))
      }
      None => {}
    }

    sql
  }
}
