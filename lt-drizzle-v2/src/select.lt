  export fn except_query(s: Select, query: Select) -> Select {
    Select(
      table: s.table,
      subquery: s.subquery,
      subquery_alias: s.subquery_alias,
      joins: s.joins,
      cte_names: s.cte_names,
      cte_queries: s.cte_queries,
