  export fn distinct(s: Select) -> Select {
    Select(
      table: s.table,
      subquery: s.subquery,
      subquery_alias: s.subquery_alias,
      joins: s.joins,
      cte_names: s.cte_names,
      cte_queries: s.cte_queries,
      select_fields: s.select_fields,
      where_clause: s.where_clause,
      group_fields: s.group_fields,
      having_clause: s.having_clause,
      order_fields: s.order_fields,
      limit_value: s.limit_value,
      offset_value: s.offset_value,
      distinct_rows: true,
      dialect: s.dialect,
      set_operator: s.set_operator,
      set_query: s.set_query,
    )
  }
