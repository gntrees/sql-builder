import sql { Sql, append, identifier, int, is_empty, join, raw } "./sql.lt"
import schema { Table } "./schema.lt"
import dialect { Dialect, sql_to_query } "./dialect.lt"
import value { Rendered, BuildError } "./value.lt"

package select {
  /// Satu klausa join.
  export struct Join {
    kind: Str
    table: Table
    on_expr: Sql
  }

  /// Builder SELECT yang immutable.
  ///
  /// Entry point: `select.create()`. Tidak ada `db` (tidak ada IO).
  export struct Select {
    table: Option<Table>
    subquery: Option<Select>
    subquery_alias: Str
    joins: List<Join>
    cte_names: List<Str>
    cte_queries: List<Select>
    select_fields: List<Sql>
    where_clause: Option<Sql>
    group_fields: List<Sql>
    having_clause: Option<Sql>
    order_fields: List<Sql>
    limit_value: Option<Int>
    offset_value: Option<Int>
    distinct_rows: Bool
    dialect: Option<Dialect>
    set_operator: Str
    set_query: Option<Select>
  }

  export fn create() -> Select {
    Select(
      table: None,
      subquery: None,
      subquery_alias: "",
      joins: [],
      cte_names: [],
      cte_queries: [],
      select_fields: [],
      where_clause: None,
      group_fields: [],
      having_clause: None,
      order_fields: [],
      limit_value: None,
      offset_value: None,
      distinct_rows: false,
      dialect: None,
      set_operator: "",
      set_query: None,
    )
  }
  export fn from_table(s: Select, table: Table) -> Select {
    Select(
      table: Some(table),
      subquery: None,
      subquery_alias: s.subquery_alias,
      joins: s.joins,
      cte_names: s.cte_names,
      cte_queries: s.cte_queries,
      select_fields: s.select_fields,
      where_clause: s.where_clause,
      group_fields: s.group_fields,
      having_clause: s.having_clause,
      order_fields: s.order_fields,
      limit_value: s.limit_value,
      offset_value: s.offset_value,
      distinct_rows: s.distinct_rows,
      dialect: s.dialect,
      set_operator: s.set_operator,
      set_query: s.set_query,
    )
  }
  export fn from_subquery(s: Select, query: Select, alias: Str) -> Select {
    Select(
      table: None,
      subquery: Some(query),
      subquery_alias: alias,
      joins: s.joins,
      cte_names: s.cte_names,
      cte_queries: s.cte_queries,
      select_fields: s.select_fields,
      where_clause: s.where_clause,
      group_fields: s.group_fields,
      having_clause: s.having_clause,
      order_fields: s.order_fields,
      limit_value: s.limit_value,
      offset_value: s.offset_value,
      distinct_rows: s.distinct_rows,
      dialect: s.dialect,
      set_operator: s.set_operator,
      set_query: s.set_query,
    )
  }
  export fn left_join(s: Select, table: Table, on_expr: Sql) -> Select {
    Select(
      table: s.table,
      subquery: s.subquery,
      subquery_alias: s.subquery_alias,
      joins: s.joins.push(Join(kind: "left", table: table, on_expr: on_expr)),
      cte_names: s.cte_names,
      cte_queries: s.cte_queries,
      select_fields: s.select_fields,
      where_clause: s.where_clause,
      group_fields: s.group_fields,
      having_clause: s.having_clause,
      order_fields: s.order_fields,
      limit_value: s.limit_value,
      offset_value: s.offset_value,
      distinct_rows: s.distinct_rows,
      dialect: s.dialect,
      set_operator: s.set_operator,
      set_query: s.set_query,
    )
  }
  export fn inner_join(s: Select, table: Table, on_expr: Sql) -> Select {
    Select(
      table: s.table,
      subquery: s.subquery,
      subquery_alias: s.subquery_alias,
      joins: s.joins.push(Join(kind: "inner", table: table, on_expr: on_expr)),
      cte_names: s.cte_names,
      cte_queries: s.cte_queries,
      select_fields: s.select_fields,
      where_clause: s.where_clause,
      group_fields: s.group_fields,
      having_clause: s.having_clause,
      order_fields: s.order_fields,
      limit_value: s.limit_value,
      offset_value: s.offset_value,
      distinct_rows: s.distinct_rows,
      dialect: s.dialect,
      set_operator: s.set_operator,
      set_query: s.set_query,
    )
  }
  export fn right_join(s: Select, table: Table, on_expr: Sql) -> Select {
    Select(
      table: s.table,
      subquery: s.subquery,
      subquery_alias: s.subquery_alias,
      joins: s.joins.push(Join(kind: "right", table: table, on_expr: on_expr)),
      cte_names: s.cte_names,
      cte_queries: s.cte_queries,
      select_fields: s.select_fields,
      where_clause: s.where_clause,
      group_fields: s.group_fields,
      having_clause: s.having_clause,
      order_fields: s.order_fields,
      limit_value: s.limit_value,
      offset_value: s.offset_value,
      distinct_rows: s.distinct_rows,
      dialect: s.dialect,
      set_operator: s.set_operator,
      set_query: s.set_query,
    )
  }
  export fn full_join(s: Select, table: Table, on_expr: Sql) -> Select {
    Select(
      table: s.table,
      subquery: s.subquery,
      subquery_alias: s.subquery_alias,
      joins: s.joins.push(Join(kind: "full", table: table, on_expr: on_expr)),
      cte_names: s.cte_names,
      cte_queries: s.cte_queries,
      select_fields: s.select_fields,
      where_clause: s.where_clause,
      group_fields: s.group_fields,
      having_clause: s.having_clause,
      order_fields: s.order_fields,
      limit_value: s.limit_value,
      offset_value: s.offset_value,
      distinct_rows: s.distinct_rows,
      dialect: s.dialect,
      set_operator: s.set_operator,
      set_query: s.set_query,
    )
  }
  export fn with_cte(s: Select, name: Str, query: Select) -> Select {
    Select(
      table: s.table,
      subquery: s.subquery,
      subquery_alias: s.subquery_alias,
      joins: s.joins,
      cte_names: s.cte_names.push(name),
      cte_queries: s.cte_queries.push(query),
      select_fields: s.select_fields,
      where_clause: s.where_clause,
      group_fields: s.group_fields,
      having_clause: s.having_clause,
      order_fields: s.order_fields,
      limit_value: s.limit_value,
      offset_value: s.offset_value,
      distinct_rows: s.distinct_rows,
      dialect: s.dialect,
      set_operator: s.set_operator,
      set_query: s.set_query,
    )
  }
  export fn fields(s: Select, items: List<Sql>) -> Select {
    Select(
      table: s.table,
      subquery: s.subquery,
      subquery_alias: s.subquery_alias,
      joins: s.joins,
      cte_names: s.cte_names,
      cte_queries: s.cte_queries,
      select_fields: items,
      where_clause: s.where_clause,
      group_fields: s.group_fields,
      having_clause: s.having_clause,
      order_fields: s.order_fields,
      limit_value: s.limit_value,
      offset_value: s.offset_value,
      distinct_rows: s.distinct_rows,
      dialect: s.dialect,
      set_operator: s.set_operator,
      set_query: s.set_query,
    )
  }
